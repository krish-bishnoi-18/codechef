#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t > 0){
        int number;
        cin >> number;
        
        int sum = 0;
        while(number > 0){             
            int remainder = number % 10;
            sum = sum + remainder;    
            number = number / 10;
        }
        
        cout << sum << endl;
        t--;
    }
    return 0;
}

