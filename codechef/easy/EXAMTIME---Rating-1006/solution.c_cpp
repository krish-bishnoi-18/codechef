#include <bits/stdc++.h>
using namespace std;

int main() {
    int t ;
    cin>>t;
	while(t--){
	    int a,b,c,d,e,f;
	    cin>>a>>b>>c>>d>>e>>f;
	    int dragon=a+b+c,sloth=d+e+f;
	    if(dragon>sloth){
	        cout<<"DRAGON"<<endl;
	    }
	    else if(dragon<sloth){
	        cout<<"SLOTH"<<endl;
	    }
	    else{
	        if(a>d){
	            cout<<"DRAGON"<<endl;
	        }
	        else if (a<d){
	            cout<<"SLOTH"<<endl;
	        }
	        else{
	            if(b>e){
	                cout<<"DRAGON"<<endl;
	            }
	            else if(b<e){
	                cout<<"SLOTH"<<endl;
	            }
	            else{
	                cout<<"Tie"<<endl;
	            }
	        }
	    }
	}

}
