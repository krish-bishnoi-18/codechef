#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    string a,b;
	    cin>>a>>b;
	    string answer;
	    for(int i =0;i<5;i++){
	        if(a[i]==b[i]){
	            answer.push_back('G');
	        }
	        else{
	            answer.push_back('B');
	        }
	    }
	    cout<<answer<<endl;
	}

}
